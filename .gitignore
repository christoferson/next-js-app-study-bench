# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# local SQLite database (D2) — local data is never committed
/data/*.db
/data/*.db-shm
/data/*.db-wal

# synthesized audio (D10) — object storage keeps the bytes, the database keeps
# the keys. Regenerating an asset is one Polly call, so the files are never
# committed (`SPEC.md` section 9.1).
/data/audio/

# imported source text (D8) — the extracted text of every document the owner
# imported. Not committed for two reasons: it is somebody else's copyrighted
# exam guide as often as not, and it is local data like the database beside it.
# The snapshot rows keep the object keys, so what is missing is visible rather
# than silent.
/data/sources/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# agent tooling — shared settings.json is committed, local overrides are not
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
external/
